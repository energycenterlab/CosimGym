# CosimGym infra ports — single source of truth.
#
# Copy this file to `src/.env` and edit if a default port is occupied on a
# shared machine. `src/.env` is read by BOTH docker-compose (native variable
# substitution) and the Python code (via src/utils/ports.py), so one change
# propagates to the containers and the simulation processes together.
#
#   cp src/.env.example src/.env      # then edit the ports you need to move
#
# `src/.env` is gitignored — each user picks their own ports without commit clashes.
# Absent `.env` → every value below is the built-in default (unchanged behavior).

# --- Redis (manager config distribution + model catalog) ---
COSIM_REDIS_PORT=6379

# --- Mosquitto / MQTT (streaming + interface federates + live dashboard) ---
# Host port; container listens on 1883 internally.
COSIM_MQTT_PORT=11883

# --- MinIO (FMU artifact store) ---
COSIM_MINIO_PORT=9000
COSIM_MINIO_CONSOLE_PORT=9101
# COSIM_MINIO_HOST=localhost

# --- HELICS broker TCP auto-assign range (ScenarioManager picks free ports here) ---
COSIM_HELICS_PORT_MIN=20000
COSIM_HELICS_PORT_MAX=30000
