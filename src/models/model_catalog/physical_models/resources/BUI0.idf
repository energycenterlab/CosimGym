    Internal plaster;         !- Layer 3

CONSTRUCTION,
    wall_internal,            !- Name
    gypsumplaster_UNI10456,    !- Outside Layer
    internal_brickwork_UNI10351,    !- Layer 2
    gypsumplaster_UNI10456;    !- Layer 3

CONSTRUCTION,
    floor_internal,           !- Name
    External plaster,         !- Outside Layer
    hollowcore_slab,          !- Layer 2
    concrete_slab_UNI10351,    !- Layer 3
    ceramic_tile_UNI10456;    !- Layer 4

GlobalGeometryRules,
    UpperLeftCorner,          !- Starting Vertex Position
    Counterclockwise,         !- Vertex Entry Direction
    Relative,                 !- Coordinate System
    Relative,                 !- Daylighting Reference Point Coordinate System
    Relative;                 !- Rectangular Surface Coordinate System

