Construction,
    window_simple,            !- Name
    window_simple;            !- Outside Layer

CONSTRUCTION,
    floor_ground,             !- Name
    External plaster,         !- Outside Layer
    hollowcore_slab,          !- Layer 2
    Cement mortar (2cm),      !- Layer 3
    Indoor flooring (stoneware);    !- Layer 4

CONSTRUCTION,
    roof_external,            !- Name
    Roof tiles,               !- Outside Layer
